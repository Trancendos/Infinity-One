# Infinity-One settings. Copy to .env (never commit .env) and fill every CHANGE_ME.
# Generate each secret with:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

POSTGRES_PASSWORD=CHANGE_ME
HYDRA_SYSTEM_SECRET=CHANGE_ME_at_least_32_chars
INTERNAL_TOKEN=CHANGE_ME_at_least_32_chars
GATE_CLIENT_SECRET=CHANGE_ME_at_least_32_chars
GATE_SESSION_SECRET=CHANGE_ME_at_least_32_chars

# Public addresses (what the browser sees, through Cloudflare Tunnel)
ISSUER_URL=https://auth.trancendos.com
PORTAL_URL=https://portal.trancendos.com
GATE_URL=https://gate.trancendos.com

# From Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > install command (the long token)
CLOUDFLARE_TUNNEL_TOKEN=

# Local testing only: HYDRA_DEV_FLAG=--dev, COOKIE_SECURE=false and http://localhost URLs.
HYDRA_DEV_FLAG=
COOKIE_SECURE=true
